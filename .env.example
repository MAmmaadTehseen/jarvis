# Telegram: create a bot with @BotFather and paste the token here
BOT_TOKEN=

# Your Telegram chat id. Leave empty, run the bot, send /start, and it will tell you.
OWNER_CHAT_ID=

# Journey settings
TZ_NAME=Asia/Karachi
START_DATE=2026-09-14

# polling for local dev, webhook in production
RUN_MODE=polling
PORT=3000
# Only for RUN_MODE=webhook. Production URL (see README for the DNS setup)
WEBHOOK_URL=https://jarvis.ammaad.online

# Shared secret for POST /cron/<job> (EventBridge Scheduler sends it as x-cron-secret)
CRON_SECRET=change-me
# Run the schedule in-process with node-cron (true locally, false on AWS where EventBridge calls /cron)
LOCAL_CRON=true
MORNING_CRON=0 9 * * *
EVENING_CRON=0 21 * * *
SUNDAY_CRON=0 19 * * 0

# DynamoDB. Leave DYNAMODB_ENDPOINT set for local dev (docker compose), unset it on AWS.
TABLE_NAME=jarvis
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8001

LOG_LEVEL=info

# Discord application: https://discord.com/developers/applications
# General Information tab
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# Bot tab -> Reset Token
DISCORD_BOT_TOKEN=

# Right-click the channel Jarvis should post nudges into -> Copy Channel ID
# (needs Settings -> Advanced -> Developer Mode)
DISCORD_CHANNEL_ID=
# Right-click yourself -> Copy User ID. Everyone else is ignored.
OWNER_USER_ID=

# Journey settings
TZ_NAME=Asia/Karachi
START_DATE=2026-09-14

# Local server (production runs on Lambda instead)
PORT=3000
# Run the nudges in-process with node-cron. On AWS this stays false:
# EventBridge Scheduler invokes the function directly.
LOCAL_CRON=false
MORNING_CRON=0 9 * * *
EVENING_CRON=0 21 * * *
SUNDAY_CRON=0 19 * * 0

# DynamoDB. Keep DYNAMODB_ENDPOINT set for local dev (docker compose); on AWS it
# must be unset so the SDK talks to the real service.
TABLE_NAME=jarvis
AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT=http://localhost:8001

LOG_LEVEL=info
